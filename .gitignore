# Dependency installs and package-manager output
node_modules/
*.egg-info/
/oai2-fe/dist/
/oai2-fe/.vite/

# Python environments, caches, and test coverage
/.venv_ds/
/.venv/
/venv/
__pycache__/
*.py[cod]
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.coverage
/coverage/
/htmlcov/

# Native and model build products
/build/
/csrc/
*.o
*.a
*.so
*.engine
*.plan
*.trt
*.pt
*.pth
*.onnx
*.etlt
*.ckpt
*.safetensors

# Local credentials and editor state
.env
.env.*
!.env.example
!.env.sample
.DS_Store
/.vscode/
/.playwright-mcp/
/.cursor/*.log
/.cursor/debug*.log
/.cursor/ds8_runtime_last.log
/.cursor/plans/

# Runtime logs, diagnostics, and local captures
/logs/
/output/
/diagnostics/
*.log
/bev-debug-*.json
/bev-debug-*.png
/bev-height-restored.png
/bev-live-*.png
/oai2-fe-bev-*.png
/Untitled

# Local model, dataset, and conversion artifacts
/data/*
!/data/.gitkeep
/models
ma_onnx_out/
ma_onnx_out_fused/
ma_onnx_out_clean/
ma_onnx_out_forward/
ma_onnxTRT/
/ma_onnx_out.tar.gz

# External source checkouts are pinned in third_party/dependencies.lock.json.
# The in-repo preprocessing shim remains ordinary tracked source.
/external/*
!/external/ds_preprocess_shim/
!/external/ds_preprocess_shim/**
/external/ds_preprocess_shim/*.so
/src/mapanything/

# DS9 generated runtime state and realized artifacts. DS9 source, configs,
# documentation, services, scripts, and tests are intentionally not ignored.
/DS9/build/
/DS9/artifacts/
/DS9/data/
/DS9/logs/
/DS9/models/engines/

# Prototype-local generated state; prototype source and tests remain trackable.
/testpipelines/**/build/
/testpipelines/**/sources.yaml
/testpipelines/**/viewer/dist/

# Known generated/local documentation snapshots only. All other Markdown and
# documentation history is intentionally visible to Git.
/docs/UNCOMMITTED_CHANGES_ANALYSIS.md
/docs/chromecastLogicmerm.html
/docs/screenshot-quick-settings-setup.md
