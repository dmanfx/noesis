FROM sha256:88d80ad35f12ec3a574cf2555a8242d33ac4110abdcc5f88a6cbdee40dfcf872

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

LABEL org.opencontainers.image.title="Noesis DS9 canonical runtime"
LABEL org.opencontainers.image.base.digest="sha256:f6fa0247da9290979cbb05749e7da9435d089c93db7c4dcfe85ba2488b5f4994"
LABEL org.opencontainers.image.source="Noesis DS9/docker/Dockerfile.runtime"
LABEL com.noesis.engine-build.image.reference="noesis-ds9-dev:9.1-20260812"
LABEL com.noesis.engine-build.image.id="sha256:88d80ad35f12ec3a574cf2555a8242d33ac4110abdcc5f88a6cbdee40dfcf872"

ENV DEBIAN_FRONTEND=noninteractive

# Runtime-only WebRTC bindings are intentionally layered on the immutable
# engine-build image. TensorRT engine provenance therefore remains bound to the
# exact image that built the engines while service dependencies can evolve
# under their own reviewed runtime-image identity.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      python3-gi=3.48.2-1 \
      gir1.2-gst-plugins-bad-1.0=1.24.2-1ubuntu4 \
    && rm -rf /var/lib/apt/lists/*

RUN GST_REGISTRY=/tmp/noesis-ds9-runtime-gst-registry.bin \
      python3 -c 'import gi; gi.require_version("Gst", "1.0"); gi.require_version("GstSdp", "1.0"); gi.require_version("GstWebRTC", "1.0"); from gi.repository import GLib, Gst, GstSdp, GstWebRTC; Gst.init(None); required=("rtspsrc", "rtph264depay", "h264parse", "rtph264pay", "webrtcbin", "queue", "fakesink"); missing=[name for name in required if Gst.ElementFactory.find(name) is None]; assert not missing, missing; assert all((GLib, GstSdp, GstWebRTC))' \
    && GST_REGISTRY=/tmp/noesis-ds9-runtime-gst-registry.bin \
      gst-inspect-1.0 webrtcbin >/dev/null \
    && rm -f /tmp/noesis-ds9-runtime-gst-registry.bin
