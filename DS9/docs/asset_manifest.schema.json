{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/schemas/ds9-native-asset-manifest-v3.json",
  "title": "Noesis native DS9.1 artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "schema",
    "updated_at",
    "target",
    "runtime",
    "policy",
    "artifacts",
    "shared_app_data",
    "packaging_boundary"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "manifest_id": {"type": "string", "minLength": 1},
    "schema": {"const": "DS9/docs/asset_manifest.schema.json"},
    "updated_at": {"type": "string", "format": "date"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "python", "deepstream", "cuda", "tensorrt", "native_host"],
      "properties": {
        "platform": {"type": "string"},
        "python": {"const": "3.12"},
        "deepstream": {
          "type": "object",
          "required": ["major", "version", "home"],
          "properties": {
            "major": {"const": 9},
            "version": {"const": "9.1"},
            "home": {"const": "/opt/nvidia/deepstream/deepstream-9.1"}
          }
        },
        "cuda": {"const": "13.2"},
        "tensorrt": {"const": "10.16.0.72"},
        "native_host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operating_system", "architecture", "driver_minimum", "gstreamer", "sdk_root", "cuda_root", "native_root_env"],
          "properties": {
            "operating_system": {"const": "ubuntu-24.04"},
            "architecture": {"const": "x86_64"},
            "driver_minimum": {"const": "595.58.03"},
            "gstreamer": {"const": "1.24.2"},
            "sdk_root": {"const": "/opt/nvidia/deepstream/deepstream-9.1"},
            "cuda_root": {"const": "/usr/local/cuda-13.2"},
            "native_root_env": {"const": "NOESIS_DS91_NATIVE_ROOT"}
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "supervisor",
        "artifact_root_env",
        "runtime_root_env",
        "entrypoint",
        "implementation",
        "pipeline_config",
        "v3dt_pipeline_config",
        "v3dt_cameras_config",
        "v3dt_tracker_config",
        "preflight",
        "canonical_world_factory",
        "capability_health_api",
        "scene_release_api"
      ],
      "properties": {
        "backend": {"const": "native_host"},
        "supervisor": {"const": "DS9/scripts/run_canonical_runtime_host.py"},
        "artifact_root_env": {"const": "NOESIS_DS9_ARTIFACT_ROOT"},
        "runtime_root_env": {"const": "NOESIS_DS9_RUNTIME_ROOT"},
        "entrypoint": {"const": "DS9/noesis/ds9_runtime.py"},
        "implementation": {"const": "DS9/noesis/ds9_runtime_core.py"},
        "pipeline_config": {"const": "DS9/config/infer.yaml"},
        "v3dt_pipeline_config": {"const": "DS9/config/infer_v3dt.yaml"},
        "v3dt_cameras_config": {"const": "DS9/config/cameras_v3dt.yaml"},
        "v3dt_tracker_config": {"const": "DS9/config/v3dt/nvtracker_v3dt.yaml"},
        "preflight": {"const": "DS9/scripts/ds9_preflight.py"},
        "canonical_world_factory": {"const": "noesis_core/runtime_world.py"},
        "capability_health_api": {"const": "noesis/server/health_api.py"},
        "scene_release_api": {"const": "noesis/server/scene_api.py"}
      }
    },
    "policy": {"type": "object"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "shared_app_data": {"type": "array", "items": {"type": "string"}},
    "packaging_boundary": {"type": "object"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role",
        "output",
        "sources",
        "builder",
        "required_profiles",
        "state",
        "compatibility",
        "provenance"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]+$"},
        "kind": {
          "enum": ["native_extension", "gstreamer_plugin", "tensorrt_plugin", "nvinfer_parser", "tensorrt_engine"]
        },
        "role": {"type": "string", "minLength": 1},
        "output": {"type": "string", "pattern": "^DS9/"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(DS9/|external/DeepStream-Yolo-Seg/nvdsinfer_custom_impl_Yolo_seg/)"
          }
        },
        "builder": {"type": "string", "pattern": "^DS9/scripts/"},
        "required_profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "state": {"enum": ["missing", "staged_unverified", "validated"]},
        "compatibility": {
          "type": "object",
          "required": ["deepstream_major", "cuda", "tensorrt"],
          "properties": {
            "deepstream_major": {"const": 9},
            "cuda": {"const": "13.2"},
            "tensorrt": {"type": ["string", "null"]},
            "precision": {"type": "string"},
            "batch": {"type": "integer", "minimum": 1}
          }
        },
        "provenance": {
          "type": "object",
          "required": ["source_sha256", "output_sha256", "built_at_utc", "build_host", "command"],
          "properties": {
            "source_sha256": {"type": ["string", "null"]},
            "output_sha256": {"type": ["string", "null"]},
            "built_at_utc": {"type": ["string", "null"]},
            "build_host": {"type": ["string", "null"]},
            "command": {"type": ["string", "null"]},
            "maintenance": {
              "type": ["object", "null"],
              "properties": {
                "manifest": {"type": "string"},
                "output_size_bytes": {"type": "integer", "minimum": 1},
                "image": {"type": "string"},
                "image_id": {"type": "string"},
                "base_digest": {"type": "string"},
                "tensorrt_version": {"type": "string"},
                "cuda_version": {"type": "string"},
                "driver_version": {"type": "string"},
                "gpu": {"type": "object"},
                "precision": {"type": "string"},
                "batch": {"type": "integer", "minimum": 1},
                "tensor_contract": {"type": "object"}
              }
            }
          }
        }
      }
    }
  }
}
