{
  "$defs": {
    "CalibrationAcceptance": {
      "additionalProperties": false,
      "properties": {
        "confidence_level": {
          "const": 0.95,
          "title": "Confidence Level",
          "type": "number"
        },
        "confidence_method": {
          "const": "clopper_pearson_one_sided",
          "title": "Confidence Method",
          "type": "string"
        },
        "max_benchmark_holdout_far_upper_confidence_bound": {
          "maximum": 0.01,
          "minimum": 0.0,
          "title": "Max Benchmark Holdout Far Upper Confidence Bound",
          "type": "number"
        },
        "max_benchmark_holdout_frr": {
          "maximum": 0.35,
          "minimum": 0.0,
          "title": "Max Benchmark Holdout Frr",
          "type": "number"
        },
        "max_benchmark_holdout_misidentification_upper_confidence_bound": {
          "maximum": 0.01,
          "minimum": 0.0,
          "title": "Max Benchmark Holdout Misidentification Upper Confidence Bound",
          "type": "number"
        },
        "max_harmful_prior_encounters": {
          "const": 0,
          "title": "Max Harmful Prior Encounters",
          "type": "integer"
        },
        "max_household_false_accept_encounters": {
          "const": 0,
          "title": "Max Household False Accept Encounters",
          "type": "integer"
        },
        "max_household_holdout_frr": {
          "maximum": 0.35,
          "minimum": 0.0,
          "title": "Max Household Holdout Frr",
          "type": "number"
        },
        "max_household_misidentification_encounters": {
          "const": 0,
          "title": "Max Household Misidentification Encounters",
          "type": "integer"
        },
        "max_prior_rejection_rescue_encounters": {
          "const": 0,
          "title": "Max Prior Rejection Rescue Encounters",
          "type": "integer"
        },
        "minimum_benchmark_holdout_known_persons": {
          "minimum": 300,
          "title": "Minimum Benchmark Holdout Known Persons",
          "type": "integer"
        },
        "minimum_benchmark_holdout_unknown_persons": {
          "minimum": 300,
          "title": "Minimum Benchmark Holdout Unknown Persons",
          "type": "integer"
        },
        "minimum_benchmark_train_known_persons": {
          "minimum": 50,
          "title": "Minimum Benchmark Train Known Persons",
          "type": "integer"
        },
        "minimum_benchmark_train_unknown_persons": {
          "minimum": 50,
          "title": "Minimum Benchmark Train Unknown Persons",
          "type": "integer"
        },
        "minimum_household_holdout_known_encounters": {
          "minimum": 20,
          "title": "Minimum Household Holdout Known Encounters",
          "type": "integer"
        },
        "minimum_household_holdout_unknown_encounters": {
          "minimum": 20,
          "title": "Minimum Household Holdout Unknown Encounters",
          "type": "integer"
        },
        "minimum_household_train_known_encounters": {
          "minimum": 10,
          "title": "Minimum Household Train Known Encounters",
          "type": "integer"
        },
        "minimum_household_train_unknown_encounters": {
          "minimum": 10,
          "title": "Minimum Household Train Unknown Encounters",
          "type": "integer"
        },
        "passed": {
          "const": true,
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "passed",
        "confidence_level",
        "confidence_method",
        "max_benchmark_holdout_far_upper_confidence_bound",
        "max_benchmark_holdout_frr",
        "max_benchmark_holdout_misidentification_upper_confidence_bound",
        "max_household_false_accept_encounters",
        "max_household_misidentification_encounters",
        "max_household_holdout_frr",
        "max_harmful_prior_encounters",
        "max_prior_rejection_rescue_encounters",
        "minimum_benchmark_train_known_persons",
        "minimum_benchmark_train_unknown_persons",
        "minimum_benchmark_holdout_known_persons",
        "minimum_benchmark_holdout_unknown_persons",
        "minimum_household_train_known_encounters",
        "minimum_household_train_unknown_encounters",
        "minimum_household_holdout_known_encounters",
        "minimum_household_holdout_unknown_encounters"
      ],
      "title": "CalibrationAcceptance",
      "type": "object"
    },
    "CalibrationDatasetBinding": {
      "additionalProperties": false,
      "properties": {
        "dataset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset Sha256",
          "type": "string"
        },
        "encounter_count": {
          "minimum": 1,
          "title": "Encounter Count",
          "type": "integer"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "evidence_sources": {
          "items": {
            "$ref": "#/$defs/CalibrationEvidenceSource"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Evidence Sources",
          "type": "array"
        },
        "evidence_stratum": {
          "$ref": "#/$defs/CalibrationEvidenceStratum"
        },
        "evidence_unit_count": {
          "minimum": 1,
          "title": "Evidence Unit Count",
          "type": "integer"
        },
        "labels_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Labels Sha256",
          "type": "string"
        },
        "observation_count": {
          "minimum": 1,
          "title": "Observation Count",
          "type": "integer"
        },
        "provenance": {
          "$ref": "#/$defs/CalibrationDatasetProvenance"
        },
        "runtime_modes": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Runtime Modes",
          "type": "array"
        },
        "runtimes": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Runtimes",
          "type": "array"
        },
        "split_strategy": {
          "$ref": "#/$defs/CalibrationSplitStrategy"
        },
        "truth_kinds": {
          "items": {
            "$ref": "#/$defs/CalibrationTruthKind"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Truth Kinds",
          "type": "array"
        }
      },
      "required": [
        "evidence_stratum",
        "dataset_sha256",
        "evidence_sha256",
        "labels_sha256",
        "split_strategy",
        "evidence_sources",
        "runtimes",
        "runtime_modes",
        "truth_kinds",
        "provenance",
        "observation_count",
        "evidence_unit_count",
        "encounter_count"
      ],
      "title": "CalibrationDatasetBinding",
      "type": "object"
    },
    "CalibrationDatasetProvenance": {
      "additionalProperties": false,
      "description": "Immutable provenance for one benchmark or household capture corpus.",
      "properties": {
        "labeling_protocol_revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Labeling Protocol Revision",
          "type": "string"
        },
        "model_semantic_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Semantic Profile Sha256",
          "type": "string"
        },
        "population_basis": {
          "enum": [
            "licensed_real_people",
            "owner_consented_household_people"
          ],
          "title": "Population Basis",
          "type": "string"
        },
        "source_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Manifest Sha256",
          "type": "string"
        },
        "source_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "source_name",
        "source_revision",
        "source_manifest_sha256",
        "model_semantic_profile_sha256",
        "labeling_protocol_revision",
        "population_basis"
      ],
      "title": "CalibrationDatasetProvenance",
      "type": "object"
    },
    "CalibrationEvidenceSource": {
      "enum": [
        "shadow",
        "replay"
      ],
      "title": "CalibrationEvidenceSource",
      "type": "string"
    },
    "CalibrationEvidenceStratum": {
      "enum": [
        "benchmark",
        "household"
      ],
      "title": "CalibrationEvidenceStratum",
      "type": "string"
    },
    "CalibrationEvidenceUnitPolicy": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "session_tracklet_time_bucket_v1",
          "title": "Algorithm",
          "type": "string"
        },
        "authority_aggregation": {
          "const": "encounter_worst_case_v1",
          "title": "Authority Aggregation",
          "type": "string"
        },
        "bucket_duration_us": {
          "const": 5000000,
          "title": "Bucket Duration Us",
          "type": "integer"
        },
        "fit_representatives_per_unit": {
          "const": 1,
          "title": "Fit Representatives Per Unit",
          "type": "integer"
        },
        "fit_thinning": {
          "const": "temporal_cover_center_representative_v1",
          "title": "Fit Thinning",
          "type": "string"
        },
        "maximum_fit_units_per_encounter": {
          "const": 8,
          "title": "Maximum Fit Units Per Encounter",
          "type": "integer"
        },
        "maximum_observations_per_unit": {
          "const": 300,
          "title": "Maximum Observations Per Unit",
          "type": "integer"
        }
      },
      "required": [
        "algorithm",
        "bucket_duration_us",
        "maximum_observations_per_unit",
        "fit_thinning",
        "maximum_fit_units_per_encounter",
        "fit_representatives_per_unit",
        "authority_aggregation"
      ],
      "title": "CalibrationEvidenceUnitPolicy",
      "type": "object"
    },
    "CalibrationFitSummary": {
      "additionalProperties": false,
      "properties": {
        "balanced_brier_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Balanced Brier Score",
          "type": "number"
        },
        "balanced_log_loss": {
          "minimum": 0.0,
          "title": "Balanced Log Loss",
          "type": "number"
        },
        "iterations": {
          "minimum": 1,
          "title": "Iterations",
          "type": "integer"
        },
        "negative_pair_count": {
          "minimum": 1,
          "title": "Negative Pair Count",
          "type": "integer"
        },
        "positive_pair_count": {
          "minimum": 1,
          "title": "Positive Pair Count",
          "type": "integer"
        },
        "score_semantics": {
          "const": "balanced_monotonic_match_score_not_posterior",
          "title": "Score Semantics",
          "type": "string"
        },
        "selected_encounter_count": {
          "minimum": 1,
          "title": "Selected Encounter Count",
          "type": "integer"
        },
        "selected_evidence_unit_count": {
          "minimum": 1,
          "title": "Selected Evidence Unit Count",
          "type": "integer"
        },
        "selected_person_count": {
          "minimum": 1,
          "title": "Selected Person Count",
          "type": "integer"
        }
      },
      "required": [
        "score_semantics",
        "selected_evidence_unit_count",
        "selected_encounter_count",
        "selected_person_count",
        "positive_pair_count",
        "negative_pair_count",
        "balanced_log_loss",
        "balanced_brier_score",
        "iterations"
      ],
      "title": "CalibrationFitSummary",
      "type": "object"
    },
    "CalibrationGalleryLimits": {
