    "IdentityOpenSetPolicyContract": {
      "additionalProperties": false,
      "properties": {
        "ambiguity_margin_floor": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ambiguity Margin Floor",
          "type": "number"
