{
  "$defs": {
    "CalibrationCandidateScore": {
      "additionalProperties": false,
      "properties": {
        "gallery_exemplar_count": {
          "default": 0,
          "minimum": 0,
          "title": "Gallery Exemplar Count",
          "type": "integer"
        },
        "hard_allowed": {
          "default": true,
          "title": "Hard Allowed",
          "type": "boolean"
        },
        "hard_constraint_reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hard Constraint Reason"
        },
        "identity_kind": {
          "enum": [
            "resident",
            "visitor"
          ],
          "title": "Identity Kind",
          "type": "string"
        },
        "raw_similarity": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Raw Similarity",
          "type": "number"
        },
        "subject_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "identity_kind",
        "raw_similarity"
      ],
      "title": "CalibrationCandidateScore",
      "type": "object"
    },
    "CalibrationDatasetProvenance": {
      "additionalProperties": false,
      "description": "Immutable provenance for one benchmark or household capture corpus.",
      "properties": {
        "labeling_protocol_revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Labeling Protocol Revision",
          "type": "string"
        },
        "model_semantic_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Semantic Profile Sha256",
          "type": "string"
        },
        "population_basis": {
          "enum": [
            "licensed_real_people",
            "owner_consented_household_people"
          ],
          "title": "Population Basis",
          "type": "string"
        },
        "source_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Manifest Sha256",
          "type": "string"
        },
        "source_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "source_name",
        "source_revision",
        "source_manifest_sha256",
        "model_semantic_profile_sha256",
        "labeling_protocol_revision",
        "population_basis"
      ],
      "title": "CalibrationDatasetProvenance",
      "type": "object"
    },
    "CalibrationEvidenceSource": {
      "enum": [
        "shadow",
        "replay"
      ],
      "title": "CalibrationEvidenceSource",
      "type": "string"
    },
    "CalibrationEvidenceStratum": {
      "enum": [
        "benchmark",
        "household"
      ],
      "title": "CalibrationEvidenceStratum",
      "type": "string"
    },
    "CalibrationEvidenceUnit": {
      "additionalProperties": false,
      "properties": {
        "bucket_index": {
          "minimum": 0,
          "title": "Bucket Index",
          "type": "integer"
        },
        "camera_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Camera Id",
          "type": "string"
        },
        "encounter_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Encounter Id",
          "type": "string"
        },
        "event_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 300,
          "minItems": 1,
          "title": "Event Ids",
          "type": "array"
        },
        "fit_event_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fit Event Id"
        },
        "partition": {
          "$ref": "#/$defs/CalibrationPartition"
        },
        "run_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CalibrationEvidenceSource"
        },
        "tracker_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tracker Id",
          "type": "string"
        },
        "truth_kind": {
          "$ref": "#/$defs/CalibrationTruthKind"
        },
        "truth_person_key": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Truth Person Key",
          "type": "string"
        },
        "truth_subject_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Truth Subject Id"
        },
        "unit_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "partition",
        "truth_kind",
        "truth_person_key",
        "encounter_id",
        "session_id",
        "run_id",
        "source",
        "camera_id",
        "tracker_id",
        "bucket_index",
        "event_ids"
      ],
      "title": "CalibrationEvidenceUnit",
      "type": "object"
    },
    "CalibrationEvidenceUnitPolicy": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "session_tracklet_time_bucket_v1",
          "title": "Algorithm",
          "type": "string"
        },
        "authority_aggregation": {
          "const": "encounter_worst_case_v1",
          "title": "Authority Aggregation",
          "type": "string"
        },
        "bucket_duration_us": {
          "const": 5000000,
          "title": "Bucket Duration Us",
          "type": "integer"
        },
        "fit_representatives_per_unit": {
          "const": 1,
          "title": "Fit Representatives Per Unit",
          "type": "integer"
        },
        "fit_thinning": {
          "const": "temporal_cover_center_representative_v1",
          "title": "Fit Thinning",
          "type": "string"
        },
        "maximum_fit_units_per_encounter": {
          "const": 8,
          "title": "Maximum Fit Units Per Encounter",
          "type": "integer"
        },
        "maximum_observations_per_unit": {
          "const": 300,
          "title": "Maximum Observations Per Unit",
          "type": "integer"
        }
      },
      "required": [
        "algorithm",
        "bucket_duration_us",
        "maximum_observations_per_unit",
        "fit_thinning",
        "maximum_fit_units_per_encounter",
        "fit_representatives_per_unit",
        "authority_aggregation"
      ],
      "title": "CalibrationEvidenceUnitPolicy",
      "type": "object"
    },
    "CalibrationPartition": {
      "enum": [
        "train",
        "holdout"
      ],
      "title": "CalibrationPartition",
      "type": "string"
    },
    "CalibrationSplitStrategy": {
      "enum": [
        "subject_disjoint",
        "session_disjoint"
      ],
      "title": "CalibrationSplitStrategy",
      "type": "string"
    },
    "CalibrationTruthKind": {
      "enum": [
        "resident",
        "visitor",
        "unknown"
      ],
      "title": "CalibrationTruthKind",
      "type": "string"
    },
    "CalibrationTruthLabel": {
      "additionalProperties": false,
      "properties": {
        "encounter_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Encounter Id",
          "type": "string"
        },
        "event_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Id",
          "type": "string"
        },
        "partition": {
          "$ref": "#/$defs/CalibrationPartition"
        },
        "truth_kind": {
          "$ref": "#/$defs/CalibrationTruthKind"
        },
        "truth_person_key": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Truth Person Key",
          "type": "string"
        },
        "truth_subject_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Truth Subject Id"
        }
      },
      "required": [
        "event_id",
        "partition",
        "truth_kind",
        "truth_person_key",
        "encounter_id"
      ],
      "title": "CalibrationTruthLabel",
      "type": "object"
    },
    "IdentityEvidenceChainCheckpoint": {
      "additionalProperties": false,
      "description": "Tail/head checkpoint for one bounded score-evidence JSONL chain.",
      "properties": {
        "checkpoint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checkpoint Sha256",
          "type": "string"
        },
        "contract": {
          "const": "noesis.identity.shadow_score_evidence_chain",
          "title": "Contract",
          "type": "string"
        },
        "contract_version": {
          "const": 1,
          "title": "Contract Version",
          "type": "integer"
        },
        "first_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Sequence"
        },
        "next_sequence": {
          "minimum": 0,
          "title": "Next Sequence",
          "type": "integer"
        },
        "previous_event_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Event Id"
        },
        "retained_bytes": {
          "minimum": 0,
          "title": "Retained Bytes",
          "type": "integer"
        },
        "retained_count": {
          "minimum": 0,
          "title": "Retained Count",
          "type": "integer"
        },
        "tail_event_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tail Event Id"
        },
        "updated_at_us": {
          "minimum": 1,
          "title": "Updated At Us",
          "type": "integer"
        }
      },
      "required": [
        "contract",
        "contract_version",
        "next_sequence",
        "retained_count",
        "retained_bytes",
        "updated_at_us",
        "checkpoint_sha256"
      ],
      "title": "IdentityEvidenceChainCheckpoint",
      "type": "object"
    },
    "LabeledCalibrationSample": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/ShadowIdentityEvidenceRecord"
        },
        "label": {
          "$ref": "#/$defs/CalibrationTruthLabel"
        }
      },
      "required": [
        "evidence",
        "label"
      ],
      "title": "LabeledCalibrationSample",
      "type": "object"
    },
    "ShadowIdentityEvidenceRecord": {
      "additionalProperties": false,
      "description": "Score-only shadow/replay evidence; biometric vectors are never serialized.",
      "properties": {
        "calibrated_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Calibrated Confidence",
          "type": "number"
        },
        "camera_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Camera Id",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CalibrationCandidateScore"
          },
          "title": "Candidates",
          "type": "array"
        },
        "contract": {
          "const": "noesis.identity.shadow_score_evidence",
          "title": "Contract",
          "type": "string"
        },
        "contract_version": {
          "const": 2,
          "title": "Contract Version",
          "type": "integer"
        },
        "embedding_dim": {
          "minimum": 1,
          "title": "Embedding Dim",
          "type": "integer"
        },
        "event_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Id",
          "type": "string"
        },
        "final_outcome": {
          "enum": [
            "resident",
            "visitor",
            "unknown"
          ],
          "title": "Final Outcome",
          "type": "string"
        },
        "final_winner_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Winner Id"
        },
        "frame_id": {
          "minimum": 0,
          "title": "Frame Id",
          "type": "integer"
        },
        "model_layer": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Layer",
          "type": "string"
        },
        "model_semantic_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Semantic Profile Sha256",
          "type": "string"
        },
        "model_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Sha256",
          "type": "string"
        },
        "observation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "observed_at_us": {
          "minimum": 1,
          "title": "Observed At Us",
          "type": "integer"
        },
        "pre_prior_winner_id": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pre Prior Winner Id"
        },
        "previous_event_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Event Id"
        },
        "prior_changed_winner": {
          "default": false,
          "title": "Prior Changed Winner",
          "type": "boolean"
        },
        "quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Quality",
          "type": "number"
        },
        "reject_reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reject Reason"
        },
        "run_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "runtime": {
          "enum": [
            "ds8",
            "ds9",
            "replay",
            "test"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "runtime_mode": {
          "enum": [
            "shadow",
            "authoritative"
          ],
          "title": "Runtime Mode",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "session_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CalibrationEvidenceSource"
        },
        "tracker_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tracker Id",
          "type": "string"
        }
      },
      "required": [
        "contract",
        "contract_version",
        "event_id",
        "sequence",
        "observed_at_us",
        "source",
        "session_id",
        "runtime",
        "runtime_mode",
        "run_id",
        "camera_id",
        "tracker_id",
        "frame_id",
        "observation_id",
        "model_sha256",
        "model_semantic_profile_sha256",
        "model_layer",
        "embedding_dim",
        "quality",
        "candidates",
        "final_outcome",
        "calibrated_confidence"
      ],
      "title": "ShadowIdentityEvidenceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "noesis.identity.calibration_dataset",
      "title": "Contract",
      "type": "string"
    },
    "contract_version": {
      "const": 2,
      "title": "Contract Version",
      "type": "integer"
    },
    "embedding_dim": {
      "minimum": 1,
      "title": "Embedding Dim",
      "type": "integer"
    },
    "evidence_chain": {
      "$ref": "#/$defs/IdentityEvidenceChainCheckpoint"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "evidence_stratum": {
      "$ref": "#/$defs/CalibrationEvidenceStratum"
    },
    "evidence_unit_policy": {
      "$ref": "#/$defs/CalibrationEvidenceUnitPolicy"
    },
    "evidence_units": {
      "items": {
        "$ref": "#/$defs/CalibrationEvidenceUnit"
      },
      "minItems": 1,
      "title": "Evidence Units",
      "type": "array"
    },
    "labeled_by": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Labeled By",
      "type": "string"
    },
    "labeling_revision": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Labeling Revision",
      "type": "string"
    },
    "labels_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Labels Sha256",
      "type": "string"
    },
    "model_layer": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Model Layer",
      "type": "string"
    },
    "model_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Model Sha256",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/CalibrationDatasetProvenance"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/LabeledCalibrationSample"
      },
      "minItems": 1,
      "title": "Samples",
      "type": "array"
    },
    "split_strategy": {
      "$ref": "#/$defs/CalibrationSplitStrategy"
    }
  },
  "required": [
    "contract",
    "contract_version",
    "evidence_sha256",
    "labels_sha256",
    "evidence_stratum",
    "split_strategy",
    "provenance",
    "labeled_by",
    "labeling_revision",
    "model_sha256",
    "model_layer",
    "embedding_dim",
    "evidence_chain",
    "evidence_unit_policy",
    "samples",
    "evidence_units"
  ],
  "title": "IdentityCalibrationDataset",
  "type": "object"
}
