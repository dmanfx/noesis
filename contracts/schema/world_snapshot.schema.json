        "posture": {
          "default": "unknown",
          "enum": [
            "standing",
            "sitting",
            "lying",
            "unknown"
          ],
          "title": "Posture",
          "type": "string"
        },
        "room_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/WorldSourceEvidence"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "stale_after_us": {
          "minimum": 1,
          "title": "Stale After Us",
          "type": "integer"
        },
        "subject": {
          "$ref": "#/$defs/SubjectRef"
        },
        "support_state": {
          "default": "unknown",
          "enum": [
            "floor",
            "seat",
            "couch",
            "unknown"
          ],
          "title": "Support State",
          "type": "string"
        },
        "support_surface": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupportSurfaceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "velocity_mps": {
          "anyOf": [
            {
              "$ref": "#/$defs/Vector3"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "world_frame": {
          "const": "backend_world_m",
          "default": "backend_world_m",
          "title": "World Frame",
          "type": "string"
        },
        "world_frame_revision": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "World Frame Revision"
        },
        "world_transform_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "World Transform Sha256"
        }
      },
      "required": [
        "entity_id",
        "subject",
        "lifecycle",
        "observed_at_us",
        "stale_after_us",
        "sources"
      ],
      "title": "WorldEntity",
      "type": "object"
    },
