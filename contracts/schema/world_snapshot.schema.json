        "position_source": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position Source"
        },
        "position_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositionState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
