        "rejection_reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Reason"
        },
        "support_surface": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupportSurfaceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "world_frame": {
          "const": "backend_world_m",
          "default": "backend_world_m",
          "title": "World Frame",
          "type": "string"
        },
        "world_frame_revision": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "World Frame Revision"
        },
        "world_transform_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "World Transform Sha256"
        },
        "zone": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone"
        },
        "zone_authoritative": {
          "default": false,
          "title": "Zone Authoritative",
          "type": "boolean"
        },
        "zone_source": {
          "anyOf": [
            {
              "enum": [
                "nvdsanalytics_roi",
                "camera_default"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone Source"
