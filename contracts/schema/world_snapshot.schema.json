      },
      "required": [
        "observation_id",
        "camera_id",
        "observed_at_us",
        "position",
        "covariance",
        "accepted"
      ],
      "title": "WorldSourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "noesis.world.snapshot",
      "title": "Contract",
      "type": "string"
    },
    "contract_version": {
      "const": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/WorldEntity"
      },
      "title": "Entities",
      "type": "array"
    },
    "frame": {
      "const": "backend_world_m",
      "title": "Frame",
      "type": "string"
    },
    "observed_end_us": {
      "minimum": 1,
      "title": "Observed End Us",
      "type": "integer"
    },
    "observed_start_us": {
      "minimum": 1,
      "title": "Observed Start Us",
      "type": "integer"
    },
    "producer": {
      "$ref": "#/$defs/ProducerRef"
    },
    "published_at_us": {
      "minimum": 1,
      "title": "Published At Us",
      "type": "integer"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "snapshot_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "units": {
      "const": "meters",
      "title": "Units",
      "type": "string"
    }
