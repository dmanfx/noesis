  "required": [
    "contract",
    "contract_version",
    "snapshot_id",
    "producer",
    "sequence",
    "observed_start_us",
    "observed_end_us",
    "published_at_us",
    "frame",
    "units",
    "entities"
  ],
  "title": "WorldSnapshot",
  "type": "object"
}
