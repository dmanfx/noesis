            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Revision"
        },
        "conflict": {
          "default": false,
          "title": "Conflict",
          "type": "boolean"
        },
        "conflict_reason": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Reason"
        },
        "continuity_segment_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
