        "position_quantity": {
          "const": "ground_footprint",
          "default": "ground_footprint",
          "title": "Position Quantity",
          "type": "string"
        },
        "position_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositionState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
