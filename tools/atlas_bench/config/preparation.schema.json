{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline Atlas generation preparation (validated again by the operator)",
  "type": "object",
  "required": ["baseline_sha256", "world_frame", "distance_unit", "provenance", "request"],
  "properties": {
    "baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "world_frame": {"type": "string", "minLength": 1},
    "distance_unit": {"type": "string", "minLength": 1},
    "depth_semantics": {"const": "planar_z"},
    "provenance": {
      "type": "object",
      "description": "Source experiment/run hashes, selected PCF transform, renderer identity, intrinsics/crop and visibility policy; no canonical writes"
    },
    "registration": {
      "type": "object",
      "description": "For A04/R01/R02: reviewed Atlas-to-metric Sim3, fit input IDs, residuals, scale, transform and report hashes. Never fit holdouts.",
      "required": ["source_frame", "target_frame", "target_from_source_row_major", "fit_frame_ids", "report_path", "report_sha256"]
    },
    "pose_neighborhood": {
      "type": "object",
      "properties": {
        "max_translation_m": {"type": "number", "minimum": 0, "maximum": 0.1},
        "max_rotation_deg": {"type": "number", "minimum": 0, "maximum": 2},
        "reference_camera": {"type": "object"}
      },
      "required": ["max_translation_m", "max_rotation_deg", "reference_camera"]
    },
    "request": {
      "type": "object",
      "description": "Documented atlasGenerate or atlasChisel body; replace each wire AssetRef with local_path, sha256, optional mime and source_frame_id. The operator uploads these and replaces them with assetId before submission.",
      "required": ["targetCameras"],
      "properties": {
        "contextFrames": {"type": "array"},
        "sourceFrames": {"type": "array"},
        "targetCameras": {"type": "array", "minItems": 1, "maxItems": 32},
        "prompt": {"type": "string"},
        "enhancePrompt": {"type": "boolean"},
        "returnDepth": {"type": "boolean"},
        "modelParameters": {"type": "object"}
      }
    }
  }
}
